# Copy to .env and fill in your values.
# Provider API keys keep their standard names (the provider SDKs read them
# directly); agent-specific settings use the AGENT_ prefix to avoid clashing
# with generic shell variables like MODEL. Set the key for whichever provider
# AGENT_MODEL points at — any provider pydantic-ai supports works here, not
# just the ones listed below; Settings validates it by asking pydantic-ai to
# build that provider at import time.

# Required when AGENT_MODEL is an Anthropic model (default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required when AGENT_MODEL is an OpenAI model
# OPENAI_API_KEY=your_openai_api_key_here

# Required when AGENT_MODEL is a Google/Gemini model
# GOOGLE_API_KEY=your_google_api_key_here

# Model selection (default: anthropic:claude-sonnet-5-5)
# AGENT_MODEL=anthropic:claude-sonnet-5-5
# AGENT_MODEL=anthropic:claude-opus-5-5
# AGENT_MODEL=google:gemini-2.0-flash
# AGENT_MODEL=ollama:llama3.3            # local Ollama — no API key, but needs OLLAMA_BASE_URL
# Must include the /v1 suffix — Ollama only serves its OpenAI-compatible API
# there. Omitting it passes config validation but 404s on the first chat call.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Judge model for LLM-as-judge evals (default: anthropic:claude-opus-5-5)
# AGENT_JUDGE_MODEL=anthropic:claude-opus-5-5

# Per-run spend cap in USD (optional; unset = no cost limit). Only for models with
# known pricing — leave it unset for ollama: models, whose cost can't be computed.
# AGENT_COST_LIMIT=0.50

# Logfire observability (optional — console output used if not set)
# LOGFIRE_TOKEN=your_logfire_token_here

# Logfire identity (optional). Rename AGENT_SERVICE_NAME per project;
# AGENT_ENVIRONMENT unset falls back to LOGFIRE_ENVIRONMENT.
# AGENT_SERVICE_NAME=agent
# AGENT_ENVIRONMENT=development

# Record prompts, outputs and tool arguments in traces (default: true).
# Set false in production if they may contain sensitive data. Evals ignore this.
# AGENT_LOG_CONTENT=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO
